{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-hooks",
    "vitest"
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "off",
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "vitest/require-mock-type-parameters": "off",
    "unicorn/no-thenable": "off",
    "unicorn/consistent-function-scoping": "off",
    "import/no-unassigned-import": "off",
    "react/memo-dependencies": "off"
  },
  "overrides": [
    {
      "files": [
        "packages/core/**/*.ts",
        "packages/react/**/*.ts",
        "packages/react/**/*.tsx"
      ],
      "rules": {
        "eqeqeq": "error",
        "no-param-reassign": "error",
        "import/no-cycle": "error",
        "typescript/ban-ts-comment": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-non-null-assertion": "error",
        "typescript/no-unsafe-argument": "error",
        "typescript/no-unsafe-assignment": "error",
        "typescript/no-unsafe-call": "error",
        "typescript/no-unsafe-member-access": "error",
        "typescript/no-unsafe-return": "error",
        "typescript/no-unsafe-type-assertion": "error",
        "typescript/no-unsafe-enum-comparison": "error",
        "typescript/consistent-return": "off",
        "typescript/no-unsafe-unary-minus": "error",
        "typescript/no-unnecessary-condition": "error",
        "typescript/no-unnecessary-type-assertion": "error",
        "typescript/switch-exhaustiveness-check": "error",
        "typescript/strict-boolean-expressions": [
          "error",
          {
            "allowString": false,
            "allowNumber": false,
            "allowNullableBoolean": false,
            "allowNullableString": false,
            "allowNullableNumber": false,
            "allowAny": false
          }
        ],
        "typescript/strict-void-return": "error",
        "typescript/await-thenable": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "typescript/only-throw-error": "error",
        "typescript/prefer-promise-reject-errors": "error",
        "typescript/restrict-plus-operands": "error",
        "typescript/restrict-template-expressions": "error",
        "typescript/no-base-to-string": "error",
        "typescript/unbound-method": "error",
        "typescript/no-deprecated": "error",
        "typescript/require-array-sort-compare": "error",
        "typescript/no-for-in-array": "error",
        "typescript/no-array-delete": "error",
        "typescript/no-implied-eval": "error",
        "typescript/no-misused-spread": "error",
        "typescript/use-unknown-in-catch-callback-variable": "error"
      }
    },
    {
      "files": [
        "packages/core/src/run/rules.ts",
        "packages/core/src/run/state.ts",
        "packages/core/src/walkthrough/*.ts",
        "packages/core/src/checklists/*.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "Rules, State, Walkthroughs and Checklists never touch the page; the Run's driver does."
          },
          {
            "name": "document",
            "message": "Rules, State, Walkthroughs and Checklists never touch the page; the Run's driver does."
          },
          {
            "name": "globalThis",
            "message": "Rules, State, Walkthroughs and Checklists never touch the page; the Run's driver does."
          },
          {
            "name": "requestAnimationFrame",
            "message": "Only the Run's driver schedules frames."
          },
          {
            "name": "performance",
            "message": "Time arrives in Messages; only the Run's driver reads the clock."
          },
          {
            "name": "localStorage",
            "message": "Only the storage adapter touches local storage."
          }
        ]
      }
    },
    {
      "files": [
        "packages/core/src/checklists/storage.ts"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": [
        "packages/core/**/*.test.ts",
        "packages/core/**/*.perf.ts",
        "packages/react/**/*.test.ts",
        "packages/react/**/*.test.tsx",
        "packages/*/src/test/**"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/strict-void-return": "off"
      }
    },
    {
      "files": ["packages/*/src/test/leaks.ts"],
      "rules": {
        "vitest/no-standalone-expect": "off"
      }
    },
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-parameters": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "scratch/**"
  ]
}
