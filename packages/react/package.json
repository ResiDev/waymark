{
  "name": "react-waymark",
  "version": "0.1.0",
  "description": "Walkthroughs and onboarding checklists for React.",
  "keywords": [
    "react",
    "walkthrough",
    "onboarding",
    "checklist",
    "product-tour",
    "guided-tour",
    "tour",
    "popover",
    "beacon",
    "waymark"
  ],
  "license": "MIT",
  "author": "Alex Boitier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ResiDev/waymark.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ResiDev/waymark/tree/main/packages/react#readme",
  "bugs": "https://github.com/ResiDev/waymark/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --project unit --project unit-react19",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project browser --project browser-react19",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:e2e && pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/browser-playwright": "^5.0.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "waymark-core": "workspace:^"
  }
}
