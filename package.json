{
  "name": "waymark-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter waymark-core --filter react-waymark build",
    "check": "pnpm --filter waymark-workspace run --parallel --reporter-hide-prefix=false \"/^(typecheck|lint|test)$/\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint",
    "test": "pnpm -r --parallel --filter waymark-core --filter react-waymark test",
    "test:watch": "pnpm --filter react-waymark test:watch",
    "dev": "pnpm --filter waymark-e2e dev",
    "dev:react": "pnpm --filter waymark-e2e dev:react",
    "shot": "pnpm --filter waymark-e2e shot",
    "size": "pnpm build && pnpm --filter waymark-e2e size",
    "test:e2e": "pnpm -r --filter waymark-core --filter react-waymark test:e2e",
    "check:all": "pnpm check && pnpm test:e2e",
    "test:perf": "pnpm --filter waymark-core test:perf",
    "setup:browser": "pnpm --filter waymark-core exec playwright install chromium"
  },
  "devDependencies": {
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^5.9.3"
  }
}
