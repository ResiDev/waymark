{
  "name": "waymark-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter waymark --filter react-waymark build",
    "check": "pnpm --filter waymark-workspace run --parallel --reporter-hide-prefix=false \"/^(typecheck|lint|test)$/\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint",
    "test": "pnpm -r --parallel --filter waymark --filter react-waymark test",
    "test:watch": "pnpm --filter react-waymark test:watch"
  },
  "devDependencies": {
    "oxlint": "^1.82.0",
    "typescript": "^5.9.3"
  }
}
